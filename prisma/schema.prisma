// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelos

model Test {
  id String @id @default(uuid())
  name String @default("Test")
}

model Cliente {
  id String @id @default(uuid())
  name String
  cuit String @unique
  domicilio String
  telefono String
  email String
  provincia   Provincia? @relation(fields: [provinciaId], references: [id])
  provinciaId String?
  ciudad     Ciudad? @relation(fields: [ciudadId], references: [id])
  ciudadId   String?
  is_active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  propuestas PropuestaTecnica[]
  clientLocations ClientLocations[]
  informes Informe[]
  planesTrabajo PlanTrabajo[]
  inspecciones InspeccionFormulario[]

  @@index([is_active])
  @@index([name])
  @@index([provinciaId])
  @@index([ciudadId])
  @@index([createdAt])
}

model Provincia {
  id String @id @default(uuid())
  nombre String
  ciudades Ciudad[]
  clientes Cliente[]
  clientLocations ClientLocations[]
}

model Ciudad {
  id String @id @default(uuid())
  nombre String
  provincia Provincia @relation(fields: [provinciaId], references: [id])
  provinciaId String
  clientes Cliente[]
  clientLocations ClientLocations[]

  @@index([provinciaId])
}

model Servicio {
  id String @id @default(uuid())
  name String
  description String
  type ServiceType @default(mensual)
  is_active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  itemsOnServicios ItemsOnServicios[]
  propuestas PropuestaTecnica[]

  @@index([is_active])
  @@index([type])
}

model Items {
  id String @id @default(uuid())
  name String
  description String
  detail String @default("")
  is_active Boolean @default(true)
  esPlanificable Boolean @default(true)
  hasVariant Boolean @default(false)
  variantType       TipoDeVariante? @relation(fields: [variantTypeId], references: [id])
  variantTypeId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  servicios ItemsOnServicios[]
  tipoDeInforme   TipoDeInforme? @relation(fields: [tipoDeInformeId], references: [id])
  tipoDeInformeId String?

  planesTrabajoProgramaciones PlanTrabajoProgramacion[]

  @@index([is_active])
  @@index([esPlanificable])
  @@index([hasVariant])
  @@index([variantTypeId])
  @@index([tipoDeInformeId])
}

model ItemsOnServicios {

  servicio Servicio @relation(fields: [servicioId], references: [id])
  servicioId String

  item Items @relation(fields: [itemId], references: [id])
  itemId String
  assignedAt DateTime @default(now())

  @@id([servicioId, itemId])
}

model PropuestaTecnica {
  id String @id @default(uuid())
  codigo String @unique
  cliente Cliente @relation(fields: [clienteId], references: [id])
  clienteId String
  servicios Servicio @relation(fields: [servicioId], references: [id])
  servicioId String
  vigencia DateTime?
  status PropuestaStatus @default(pendiente)
  items String[]
  valor Decimal @default(0)
  moneda Moneda @default(ARS)
  contacto   String?
  is_active Boolean @default(true)
  condicionesParticulares String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())


  informes Informe[]
  planesTrabajo PlanTrabajo[]

  @@index([clienteId])
  @@index([servicioId])
  @@index([status])
  @@index([is_active])
  @@index([vigencia])
  @@index([createdAt])
}

model TipoDeInforme {
  id String @id @default(uuid())
  name String
  description String?
  is_active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  items Items[]
  informes Informe[]
}
model TipoDeVariante {
  id String @id @default(uuid())
  name String
  description String?
  is_active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  items Items[]
  detalles DetalleVariante[]
}

model ClientLocations {
  id String @id @default(uuid())
  name String
  clienteId String
  cliente Cliente @relation(fields: [clienteId], references: [id])
  provincia   Provincia? @relation(fields: [provinciaId], references: [id])
  provinciaId String?
  ciudad     Ciudad? @relation(fields: [ciudadId], references: [id])
  ciudadId   String?
  is_active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  informes Informe[]
  planesTrabajoProgramaciones PlanTrabajoProgramacion[]
  inspecciones InspeccionFormulario[]

  @@index([clienteId])
  @@index([provinciaId])
  @@index([ciudadId])
  @@index([is_active])
}

model Informe {
  id                   String         @id @default(uuid())

  clienteId            String
  cliente              Cliente        @relation(fields: [clienteId], references: [id])

  tipoDeInformeId      String
  tipoDeInforme        TipoDeInforme  @relation(fields: [tipoDeInformeId], references: [id])

  propuestaId          String
  propuesta            PropuestaTecnica @relation(fields: [propuestaId], references: [id])

  clientLocationId     String
  clientLocation       ClientLocations @relation(fields: [clientLocationId], references: [id])

  fechaVencimiento     DateTime
  responsableConfeccion String
  estado               InformeEstado   @default(pendiente)
  adjunto              String?

  planTrabajoProgramacionId String? @unique
  planTrabajoProgramacion   PlanTrabajoProgramacion? @relation(fields: [planTrabajoProgramacionId], references: [id])

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @default(now())
  inspeccion InspeccionFormulario?

  @@index([clienteId])
  @@index([tipoDeInformeId])
  @@index([propuestaId])
  @@index([clientLocationId])
  @@index([estado])
  @@index([fechaVencimiento])
  @@index([createdAt])
}

model PlanTrabajo {
  id String @id @default(uuid())

  clienteId String
  cliente Cliente @relation(fields: [clienteId], references: [id])

  propuestaId String
  propuesta PropuestaTecnica @relation(fields: [propuestaId], references: [id])

  fechaInicio DateTime
  fechaFin DateTime
  estado PlanTrabajoEstado @default(pendiente_programacion)

  programaciones PlanTrabajoProgramacion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([clienteId])
  @@index([propuestaId])
  @@index([estado])
  @@index([fechaInicio])
  @@index([fechaFin])
  @@index([createdAt])
}

model PlanTrabajoProgramacion {
  id String @id @default(uuid())

  planTrabajoId String
  planTrabajo PlanTrabajo @relation(fields: [planTrabajoId], references: [id])

  itemId String
  item Items @relation(fields: [itemId], references: [id])

  fechaProgramada DateTime
  precision ProgramacionPrecision @default(dia)

  clientLocationId String?
  clientLocation ClientLocations? @relation(fields: [clientLocationId], references: [id])

  ejecutadoAt DateTime?
  adjunto     String?

  informe Informe?
  detalleVarianteId String?
  detalleVariante DetalleVariante? @relation(fields: [detalleVarianteId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([planTrabajoId])
  @@index([itemId])
  @@index([fechaProgramada])
  @@index([clientLocationId])
  @@index([ejecutadoAt])
  @@index([detalleVarianteId])
}

model DetalleVariante {
  id String @id @default(uuid())
  name String
  description String?
  is_active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  variantType   TipoDeVariante @relation(fields: [variantTypeId], references: [id])
  variantTypeId String

  planTrabajoProgramaciones PlanTrabajoProgramacion[]

  @@index([variantTypeId])
  @@index([is_active])
}

model Condicion {
  id          String         @id @default(uuid())
  tipo        CondicionTipo
  title       String
  description String         @db.Text
  category    String?
  is_active   Boolean        @default(true)
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([tipo])
  @@index([is_active])
  @@index([category])
  @@index([order])
}

// RBAC

model User {
  id String @id @default(uuid())

  // Nullable durante la migración a better-auth: los usuarios creados por el
  // nuevo proveedor no tienen clerkId. La columna se elimina en una migración
  // posterior, recién cuando el cutover está confirmado — mientras exista, un
  // rollback a la imagen con Clerk sigue arrancando sin tocar la base.
  clerkId String? @unique

  email String  @unique
  name  String?

  // Requeridos por better-auth. Los usuarios importados de Clerk se marcan
  // emailVerified=true: ya estaban verificados allá, y con
  // requireEmailVerification activo quedarían sin poder entrar.
  emailVerified Boolean @default(false)
  image         String?

  roleId   String
  role     Role    @relation(fields: [roleId], references: [id])
  isActive Boolean @default(true)

  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  inspecciones InspeccionFormulario[]
  sessions     Session[]
  accounts     Account[]

  @@index([clerkId])
  @@index([roleId])
  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Modelos de better-auth. Generados con `npx @better-auth/cli generate` y
// adaptados a las convenciones del schema: sin @@map (las tablas son
// PascalCase como el resto) y con @default(uuid()) por robustez.
// ---------------------------------------------------------------------------

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id         String @id @default(uuid())
  accountId  String
  providerId String
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?

  // Hash de la contraseña para providerId="credential". Acá se escriben los
  // password_digest bcrypt importados desde Clerk, sin re-hashear.
  password String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([providerId, accountId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  label       String
  description String?
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  module      String
  action      String
  description String
  roles       RolePermission[]

  @@index([module])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
}

// Inspecciones Ambientales — Catálogo

model SeccionInspeccion {
  id        String @id @default(uuid())
  codigo    String @unique
  titulo    String
  parentId  String?
  parent    SeccionInspeccion?  @relation("SeccionHija", fields: [parentId], references: [id])
  hijas     SeccionInspeccion[] @relation("SeccionHija")
  orden     Int
  preguntas PreguntaInspeccion[]

  @@index([parentId])
  @@index([orden])
}

model PreguntaInspeccion {
  id                  String @id @default(uuid())
  codigo              String @unique
  texto               String
  seccionId           String
  seccion             SeccionInspeccion @relation(fields: [seccionId], references: [id])
  orden               Int
  parentPreguntaId    String?
  parentPregunta      PreguntaInspeccion?  @relation("PreguntaCondicional", fields: [parentPreguntaId], references: [id])
  hijasCondicionales  PreguntaInspeccion[] @relation("PreguntaCondicional")
  condicionRespuesta  String?

  acciones   AccionCorrectivaInspeccion[]
  respuestas InspeccionRespuesta[]

  @@index([seccionId])
  @@index([parentPreguntaId])
  @@index([orden])
}

model AccionCorrectivaInspeccion {
  id          String @id @default(uuid())
  preguntaId  String
  pregunta    PreguntaInspeccion @relation(fields: [preguntaId], references: [id])
  texto       String
  orden       Int

  selecciones InspeccionAccionSeleccionada[]

  @@index([preguntaId])
  @@index([orden])
}

// Inspecciones Ambientales — Operativo

model InspeccionFormulario {
  id               String            @id @default(uuid())
  clienteId        String
  cliente          Cliente           @relation(fields: [clienteId], references: [id])
  tipo             InspeccionTipo
  fecha            DateTime          @default(now())
  fechaInspeccion  DateTime?
  estado           InspeccionEstado   @default(borrador)
  realizadoPorId   String
  realizadoPor     User              @relation(fields: [realizadoPorId], references: [id])
  clientLocationId String?
  clientLocation   ClientLocations?  @relation(fields: [clientLocationId], references: [id])
  lugarTexto       String?
  firmaR2Key       String?
  informeId        String?           @unique
  informe          Informe?          @relation(fields: [informeId], references: [id])
  respuestas       InspeccionRespuesta[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([clienteId])
  @@index([realizadoPorId])
  @@index([estado])
  @@index([tipo])
  @@index([fecha])
  @@index([fechaInspeccion])
  @@index([clientLocationId])
}

model InspeccionRespuesta {
  id             String              @id @default(uuid())
  formularioId   String
  formulario     InspeccionFormulario @relation(fields: [formularioId], references: [id], onDelete: Cascade)
  preguntaId     String
  pregunta       PreguntaInspeccion  @relation(fields: [preguntaId], references: [id])
  valor          RespuestaValor
  observaciones  String?
  accionesSeleccionadas InspeccionAccionSeleccionada[]
  imagenes              InspeccionRespuestaImagen[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([formularioId, preguntaId])
  @@index([formularioId])
  @@index([preguntaId])
}

model InspeccionRespuestaImagen {
  id           String             @id @default(uuid())
  respuestaId  String
  respuesta    InspeccionRespuesta @relation(fields: [respuestaId], references: [id], onDelete: Cascade)
  r2Key        String
  orden        Int
  createdAt    DateTime           @default(now())

  @@index([respuestaId])
}

model InspeccionAccionSeleccionada {
  respuestaId String
  respuesta   InspeccionRespuesta        @relation(fields: [respuestaId], references: [id], onDelete: Cascade)
  accionId    String
  accion      AccionCorrectivaInspeccion  @relation(fields: [accionId], references: [id])

  @@id([respuestaId, accionId])
  @@index([respuestaId])
}



// ENUM

enum InformeEstado {
  pendiente
  entregado
}

enum PlanTrabajoEstado {
  pendiente_programacion
  programado_incompleto
  programado_completo
  en_desarrollo
  finalizado_con_pendientes
  finalizado_completo
}

enum ProgramacionPrecision {
  mes
  dia
}

enum PropuestaStatus {
  pendiente
  aprobada
  rechazada
  en_progreso
  finalizada
}
  
enum Moneda {
  ARS
  USD
  EUR
}

enum ServiceType {
  mensual
  unitario
}

enum CondicionTipo {
  general
  particular
}

enum InspeccionEstado {
  borrador
  completada
}

enum InspeccionTipo {
  inspeccion_base
  inspeccion_equipo
}

enum RespuestaValor {
  si
  no
  na
}

// Modelo agregado por @codecontrol/taskapp-cli para el módulo de Ayuda.
// Guarda el "yo lo vi" del usuario por cada ticket de TaskApp.
// La PK compuesta (user_id, taskapp_ticket_id) asegura una sola view por par.
model support_ticket_views {
  user_id             String
  taskapp_ticket_id   BigInt
  last_seen_at        DateTime @default(now()) @db.Timestamptz(6)
  last_seen_status_id BigInt
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  @@id([user_id, taskapp_ticket_id])
  @@index([user_id], map: "idx_support_ticket_views_user_id")
  @@index([taskapp_ticket_id], map: "idx_support_ticket_views_taskapp_ticket_id")
}
